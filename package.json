{
  "name": "wix-domains-qa",
  "version": "0.1.0",
  "private": true,
  "description": "QA for Wix Domains: \"Can I get this name?\" across the storefront, BNG, WHOIS and the public Domain Search API",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=storefront",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^20.19.43",
    "typescript": "^7.0.2"
  }
}
