# Copy to .env (git-ignored) and fill in. Never commit real values.

# Account-level API key from https://manage.wix.com/account/api-keys (Domains permission)
WIX_API_KEY=

# Account ID, shown on the same API keys page
WIX_ACCOUNT_ID=

# Optional: hard cap on API calls per test run (default 60)
MAX_API_CALLS=60
